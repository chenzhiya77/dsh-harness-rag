{
  "name": "dsh-harness-rag",
  "description": "Harness RAG for DeepSeek Harness: three-path retrieval (hybrid/graph/wiki), document continuation reading, and a knowledge-base management panel over the Harness RAG knowledge service.",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenzhiya77/dsh-harness-rag.git"
  },
  "homepage": "https://github.com/chenzhiya77/dsh-harness-rag#readme",
  "files": [
    "icon.svg",
    "lib",
    "src",
    "client.js",
    "cordis.patch.yml",
    "presets",
    "locale",
    "docs/equivalence.md",
    "docs/plugin-manual.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "runtime.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "build:plugin": "tsc -p tsconfig.build.json --pretty false",
    "prepack": "npm run build:plugin",
    "build:runtime": "node scripts/build-runtime-pack.mjs --engine ./engine"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "cordis": ">=4.0.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^22.20.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "typescript": "^6.0.3",
    "yazl": "^3.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "yauzl": "^3.4.0"
  }
}
